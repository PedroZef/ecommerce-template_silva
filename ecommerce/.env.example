# ============================================================
#  Modelo de variáveis de ambiente do E-commerce
#  Copie este arquivo para `.env` e preencha com suas chaves.
#  O `.env` é ignorado pelo Git — NUNCA versionar chaves reais.
# ============================================================

# Chat do Assistente IA via OpenRouter (modelo google/gemini-2.5-flash)
# Sem esta chave, o assistente opera apenas em modo offline.
OPENROUTER_API_KEY=

# Transcrição de comando de voz via Groq (Whisper large-v3)
# Sem esta chave, o comando de voz retorna aviso para usar texto.
GROQ_API_KEY=

# Chave de assinatura JWT em Base64 (mínimo 256 bits)
# OBRIGATÓRIA em produção — a aplicação não inicia sem ela (fail-fast).
# Gere uma segura com: openssl rand -base64 64
JWT_SECRET=
